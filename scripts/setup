#!/usr/bin/env bash
# vkintox flatpak installer
# usage: curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash [-s -- APP_ID]

set -euo pipefail

REPO="buwryme/VKIntox"
WORKFLOW="flatpak-build.yml"
LAYER_ID="org.freedesktop.Platform.VulkanLayer.VKIntox"
# the M3 font set, the curated EffectPackages.ini and the built-in shaders are
# not on main yet, so seed all of them from the experimental branch.
# TODO: point this at main once those assets are merged.
ASSET_REF="v0.2.0-experimental"
EFFECT_PACKAGES_URL="${VKINTOX_EFFECT_PACKAGES_URL:-https://raw.githubusercontent.com/$REPO/refs/heads/$ASSET_REF/assets/EffectPackages.ini}"

if [[ -t 1 ]]; then
    B='\033[1m'; BLUE='\033[34m'; GREEN='\033[32m'; YELLOW='\033[33m'; RED='\033[31m'; DIM='\033[2m'; NC='\033[0m'
    SPIN_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    # Nerd Font chevron up then down, shown dimmed beside a prompt to advertise
    # that the list takes arrow keys. Real bytes rather than the literal-escape
    # form the colour variables use, because this one is passed as a %s argument.
    NAV_HINT=$''
else
    B=''; BLUE=''; GREEN=''; YELLOW=''; RED=''; DIM=''; NC=''
    SPIN_FRAMES=()
    NAV_HINT=''
fi

spin_pid=""
start_spin() {
    # return 0, not a bare return: a bare return propagates the failed [[ ]] as
    # status 1, and set -e would kill the script on the first run_progress when
    # stdout is not a terminal, which is every non-interactive invocation
    [[ ${#SPIN_FRAMES[@]} -gt 0 ]] || return 0
    local msg="$1"
    (
        local i=0
        while true; do
            printf "\r  ${BLUE}${SPIN_FRAMES[$((i % ${#SPIN_FRAMES[@]}))]}${NC} %s  " "$msg"
            ((i += 1))
            sleep 0.12
        done
    ) &
    spin_pid=$!
    disown "$spin_pid" 2>/dev/null || true
}
stop_spin() {
    if [[ -n "$spin_pid" ]]; then
        kill "$spin_pid" 2>/dev/null || true
        wait "$spin_pid" 2>/dev/null || true
        spin_pid=""
        [[ ! -t 1 ]] || printf '\r\033[K'
    fi
}
say() { stop_spin; printf "${BLUE}  →${NC} %s\n" "$*"; }
ok() { stop_spin; printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn() { stop_spin; printf "${YELLOW}  !${NC} %s\n" "$*"; }
die() { stop_spin; printf "${RED}  ✗${NC} %s\n" "$*" >&2; exit 1; }
section() { stop_spin; printf "\n${BLUE}${B}%s${NC}\n" "$*"; }
finish() { stop_spin; printf "\n${BLUE}${B}%s${NC}\n" "$*"; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing $1 — install it first"; }
run_progress() {
    local label="$1" log status
    shift
    log="$TMP_DIR/${label//[^a-zA-Z0-9_-]/_}.log"
    start_spin "$label..."
    if "$@" >"$log" 2>&1; then
        ok "$label"
    else
        status=$?
        stop_spin
        cat "$log" >&2
        die "$label failed (exit $status)"
    fi
}

# The terminal state the menu found the tty in, captured once so it can be put
# back no matter how the script ends. A terminal left in -icanon -echo does not
# look broken so much as feel broken: nothing echoes and reads swallow one
# character at a time, so the shell that invoked us is unusable until reset.
TTY_SAVED=""
save_tty() {
    # a piped script (curl | bash) has no tty on stdin, but the user is still
    # sitting at one, so capture the controlling terminal instead
    if [[ -t 0 ]]; then
        TTY_SAVED=$(stty -g 2>/dev/null || true)
    elif [[ -r /dev/tty ]]; then
        TTY_SAVED=$(stty -g </dev/tty 2>/dev/null || true)
    fi
}
restore_tty() {
    [[ -n "$TTY_SAVED" ]] || return 0
    if [[ -t 0 ]]; then
        stty "$TTY_SAVED" 2>/dev/null || true
    elif [[ -r /dev/tty ]]; then
        stty "$TTY_SAVED" </dev/tty 2>/dev/null || true
    fi
}

usage() {
    cat <<'EOF'
usage:
  curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash
  curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash -s -- com.target.app
  curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash -s -- uninstall
EOF
}

# Removes the layer and the local repo it came from. The config directories are
# deliberately left alone: shader presets, profiles and the effect list are the
# user's own work, and an uninstall that deletes them is an uninstall nobody
# wants to have to redo.
uninstall_layer() {
    section "removing layer"
    local installed
    installed=$(flatpak list --user --runtime --columns=application,branch 2>/dev/null | awk -v id="$LAYER_ID" '$1==id{print id "//" $2}')
    if [ -n "$installed" ]; then
        while read -r ref; do
            [ -n "$ref" ] || continue
            run_progress "uninstalling $ref" flatpak uninstall --user --noninteractive -y "$ref"
        done <<<"$installed"
    else
        ok "layer is not installed"
    fi

    section "removing local repo"
    if flatpak remote-list --user 2>/dev/null | awk '{print $1}' | grep -qx 'vkintox-local'; then
        run_progress "removing vkintox-local" flatpak remote-remove --user vkintox-local
    else
        ok "vkintox-local remote is not configured"
    fi

    if [[ -d "$BUILD_ROOT" ]]; then
        rm -rf -- "$BUILD_ROOT"
        ok "removed the local build cache"
    fi

    section "config kept"
    local kept
    kept=$(find "$HOME/.var/app" -maxdepth 3 -type d -name VKIntox -path '*/config/*' 2>/dev/null | head -5)
    if [[ -n "$kept" ]]; then
        printf "%s\n" "$kept" | while IFS= read -r line; do printf "  %s\n" "$line"; done
    else
        printf "  ${DIM}no per-app config directories found${NC}\n"
    fi
    printf "  ${DIM}reinstall with the same command to pick your settings back up${NC}\n"
}

# Arrow-key picker used for the install method and the version list. The chosen
# index comes back in SELECTED. Without a terminal on stdin there is nobody to
# answer the prompt, so it takes the first entry and returns instead of hanging —
# that is what keeps the curl|bash path usable from CI and nested scripts.
select_menu() {
    local prompt="$1"; shift
    local -a labels=("$@")
    local count=${#labels[@]}
    local cursor=0 drawn=0 index key rest

    SELECTED=0
    (( count > 0 )) || return 0

    # stdin is the script itself when piped (curl | bash), so read from the
    # controlling terminal instead of silently taking the default
    local read_fd=0
    if [[ ! -t 0 ]]; then
        if exec 3</dev/tty 2>/dev/null && [[ -t 3 ]]; then
            read_fd=3
        else
            printf "${DIM}  %s${NC} %b\n" "$prompt" "${labels[0]}"
            return 0
        fi
    fi
    # without stty the terminal stays canonical, arrow keys would sit in the line
    # buffer until enter, and the prompt would look frozen. say so and take the
    # default instead of pretending the keys work
    if ! command -v stty >/dev/null 2>&1; then
        warn "stty is unavailable, so arrow keys cannot be read; taking the default"
        printf "${DIM}  %s${NC} %b\n" "$prompt" "${labels[0]}"
        if (( read_fd == 3 )); then exec 3<&-; fi
        return 0
    fi

    # -icanon rather than raw: canonical mode buffers until Enter, so a single
    # read would never see an arrow key. ISIG stays on so ctrl-c still aborts,
    # and because that means ctrl-c arrives as a signal rather than a byte, the
    # restore lives in the EXIT trap instead of at the end of this function
    stty -icanon min 1 time 0 -echo <&"$read_fd" 2>/dev/null || true

    # leading blank line, so a prompt sits like section() does instead of
    # crowding whatever the previous step printed
    printf "\n"

    while true; do
        if (( drawn > 0 )); then
            printf "\033[%dA" "$drawn"
        fi
        printf "\r\033[K${B}%s${NC} ${DIM}%s${NC}\n" "$prompt" "$NAV_HINT"
        for ((index = 0; index < count; index++)); do
            # %b, not %s: the labels carry colour codes built from the literal
            # -escape variables, and printf only expands those in a format
            # string. With %s the raw "\033[32m" text would land on the screen.
            if (( index == cursor )); then
                printf "\r\033[K  ${BLUE}${B}>${NC} %b\n" "${labels[index]}"
            else
                printf "\r\033[K    %b\n" "${labels[index]}"
            fi
        done
        drawn=$(( count + 1 ))

        key=""
        IFS= read -rsn1 -u "$read_fd" key || true
        [[ -n "$key" ]] || break
        if [[ "$key" == $'\e' || "$key" == $'\033' ]]; then
            # arrows arrive as ESC [ A/B, or ESC O A/B from some terminals
            rest=""
            IFS= read -rsn2 -u "$read_fd" rest || true
            case "$rest" in
                '[A' | 'OA') cursor=$(( (cursor - 1 + count) % count )) ;;
                '[B' | 'OB') cursor=$(( (cursor + 1) % count )) ;;
            esac
            continue
        fi
        case "$key" in
            $'\r' | $'\n') break ;;
            # ctrl-c is normally a signal, not a byte, so this only fires on a
            # terminal with ISIG off. ctrl-d does arrive as a byte in raw mode.
            # either way die() exits and the EXIT trap puts the tty back.
            $'\003' | $'\004') die "aborted" ;;
        esac
    done

    restore_tty
    if (( read_fd == 3 )); then exec 3<&-; fi

    # wipe the menu and leave one confirmation line, so the transcript reads as
    # a choice rather than a scrolling list that was redrawn a dozen times
    printf "\033[%dA" "$drawn"
    for ((index = 0; index < drawn; index++)); do
        printf "\r\033[K\n"
    done
    printf "\033[%dA" "$drawn"
    printf "  ${GREEN}✓${NC} %b\n" "${labels[$cursor]}"
    SELECTED=$cursor
}

APP_ID="${1:-sober}"
[[ "$APP_ID" != "-h" && "$APP_ID" != "--help" ]] || { usage; exit 0; }

TMP_DIR=$(mktemp -d)
BUILD_ROOT="$HOME/.local/share/flatpak-builder/vkintox-remote-setup"
cleanup() {
    local status=$?
    trap - EXIT HUP INT TERM
    # first, because a signal that kills us mid-menu leaves the tty in raw mode
    # and the user's shell inherits it
    restore_tty
    if [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]]; then
        rm -rf -- "$TMP_DIR"
    fi
    stop_spin
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
save_tty

# uninstall short-circuits before the install dependencies, because removing a
# layer should not require curl, python3 or a shader download to work
case "$APP_ID" in
    uninstall | --uninstall | -u)
        need_cmd flatpak
        uninstall_layer
        finish "uninstalled"
        exit 0
        ;;
esac

[[ "$APP_ID" != "sober" ]] || APP_ID="org.vinegarhq.Sober"

for cmd in curl jq unzip flatpak flatpak-builder python3 sha256sum readelf grep install awk sed sort mktemp find head basename dirname; do need_cmd "$cmd"; done

section "dependencies"
if ! flatpak remote-list --user 2>/dev/null | grep -q '^flathub'; then
    flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    ok "added flathub remote"
else
    ok "flathub remote exists"
fi

section "fetching vkintox build"
API="https://api.github.com/repos/$REPO"
# a token lifts the unauthenticated GitHub API rate limit, which is what turns
# this into a 403 on a shared connection. either variable name is accepted.
AUTH_ARGS=()
if [[ -n "${GITHUB_TOKEN:-${GH_TOKEN:-}}" ]]; then
    AUTH_ARGS=(-H "Authorization: Bearer ${GITHUB_TOKEN:-$GH_TOKEN}")
fi
HTTP_CODE=$(curl -sSL -w '%{http_code}' -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' "${AUTH_ARGS[@]}" \
    "$API/releases/tags/flatpak-build" -o "$TMP_DIR/release.json" || true)
case "$HTTP_CODE" in
    200) ;;
    403) die "GitHub API rate limit hit (HTTP 403); set GH_TOKEN or wait and retry" ;;
    404) die "the public flatpak-build release is missing; run the manual $WORKFLOW workflow first" ;;
    *)   die "couldn't fetch the flatpak-build release (HTTP ${HTTP_CODE:-no response})" ;;
esac

# Every published build lands in the one rolling flatpak-build release, with the
# version and build date encoded in the asset name, so the version list is
# whatever has actually been built instead of a list someone has to maintain.
# Newest build per version wins, stable builds are listed before experimental
# ones, and a version counts as experimental only when it ends in -experimental.
jq -r '
    def vkey: sub("^v"; "") | sub("[-+].*$"; "") | split(".") | map(tonumber? // 0);
    [.assets[]
     | select(.name | test("^libvkintox_flatpak_.+_[0-9]{8}\\.so$"))
     | { v: (.name | sub("^libvkintox_flatpak_"; "") | sub("_[0-9]{8}\\.so$"; "")),
         url: .browser_download_url,
         created: .created_at }]
    | sort_by(.created) | reverse
    | reduce .[] as $a ([];
        (map(select(.v == $a.v)) | length) as $seen
        | if $seen == 0 then . + [$a] else . end)
    | (map(select(.v | endswith("-experimental") | not)) | sort_by(.v | vkey) | reverse) as $stable
    | (map(select(.v | endswith("-experimental"))) | sort_by(.v | vkey) | reverse) as $experimental
    | ($stable + $experimental)[]
    | "\(.v)\t\(.url)"
' "$TMP_DIR/release.json" >"$TMP_DIR/versions.tsv"

declare -a VERSION_NAMES=() VERSION_URLS=() VERSION_LABELS=()
while IFS=$'\t' read -r version_name version_url; do
    [[ -n "$version_name" ]] || continue
    VERSION_NAMES+=("$version_name")
    VERSION_URLS+=("$version_url")
done <"$TMP_DIR/versions.tsv"
((${#VERSION_NAMES[@]})) || die "the flatpak-build release has no dated library asset"

# stable entries sort first, so the newest stable build is index 0 and is the
# one we mark recommended
for version_index in "${!VERSION_NAMES[@]}"; do
    version_label="${VERSION_NAMES[$version_index]}"
    if [[ "$version_label" == *-experimental ]]; then
        version_label="${YELLOW}${version_label} (experimental! be careful)${NC}"
    elif (( version_index == 0 )); then
        version_label="${GREEN}${version_label} (recommended)${NC}"
    fi
    VERSION_LABELS+=("$version_label")
done

select_menu "pick installation method:" "fetch latest" "choose manually"
if (( SELECTED == 1 )); then
    select_menu "multiple versions found:" "${VERSION_LABELS[@]}"
    ASSET_URL="${VERSION_URLS[$SELECTED]}"
else
    # prefer the newest stable build, so an actively-built experimental branch
    # can never become the default; only fall back to any build if none is stable
    ASSET_URL=$(jq -er '
        [ .assets[] | select(.name | test("^libvkintox_flatpak_.+_[0-9]{8}\\.so$")) ]
        | (map(select(.name | contains("-experimental") | not))) as $stable
        | (if ($stable | length) > 0 then $stable else . end)
        | sort_by(.created_at) | last
        | .browser_download_url // empty
    ' "$TMP_DIR/release.json") || die "the flatpak-build release has no dated library asset"
fi
LIBRARY="$TMP_DIR/$(basename "$ASSET_URL")"
say "downloading $(basename "$ASSET_URL")"
curl -fsSL "$ASSET_URL" -o "$LIBRARY" || die "couldn't download the Flatpak library for $ASSET_URL"
[[ -s "$LIBRARY" ]] || die "downloaded Flatpak library is empty"
if ! ELF_HEADER=$(LC_ALL=C readelf -h "$LIBRARY" 2>/dev/null); then
    die "downloaded file is not a readable ELF library"
fi
grep -Eq 'Class:[[:space:]]+ELF64' <<<"$ELF_HEADER" || die "downloaded file is not an ELF64 library"
grep -Eq 'Machine:[[:space:]]+Advanced Micro Devices X86-64' <<<"$ELF_HEADER" || die "downloaded library is not x86_64"
ok "downloaded binary"

section "installing layer"
cat >"$TMP_DIR/VKIntox.json" <<'JSON'
{
  "id": "org.freedesktop.Platform.VulkanLayer.VKIntox",
  "branch": "26.08",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "build-extension": true,
  "modules": [{
    "name": "vkintox",
    "buildsystem": "simple",
    "build-commands": [
      "install -Dm755 libvkintox.so ${FLATPAK_DEST}/lib/libvkintox.so",
      "install -Dm644 VKIntox.json ${FLATPAK_DEST}/share/vulkan/implicit_layer.d/VKIntox.json"
    ],
    "sources": [
      { "type": "file", "path": "LIBRARY_PATH", "dest-filename": "libvkintox.so" },
      { "type": "file", "path": "MANIFEST_PATH", "dest-filename": "VKIntox.json" }
    ]
  }]
}
JSON
sed -i \
  -e "s|LIBRARY_PATH|$LIBRARY|" \
  -e "s|MANIFEST_PATH|$TMP_DIR/layer-manifest.json|" \
  "$TMP_DIR/VKIntox.json"

# Produce the same implicit-layer manifest as the project packaging config.
cat >"$TMP_DIR/layer-manifest.json" <<'JSON'
{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "VK_LAYER_VKINTOX_post_processing",
    "type": "GLOBAL",
    "library_path": "/usr/lib/extensions/vulkan/VKIntox/lib/libvkintox.so",
    "api_version": "1.3.223",
    "implementation_version": "1",
    "description": "a post processing layer with overlay UI",
    "functions": {
      "vkGetInstanceProcAddr": "VKIntox_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "VKIntox_GetDeviceProcAddr"
    },
    "enable_environment": { "ENABLE_VKINTOX": "1" },
    "disable_environment": { "DISABLE_VKINTOX": "1" }
  }
}
JSON

mkdir -p "$BUILD_ROOT"
mkdir -p "$BUILD_ROOT/repo"
run_progress "preparing flatpak package" flatpak-builder --user --force-clean --disable-rofiles-fuse \
    --install-deps-from=flathub \
    --state-dir="$BUILD_ROOT/state" \
    --repo="$BUILD_ROOT/repo" "$BUILD_ROOT/build" "$TMP_DIR/VKIntox.json"
if ! flatpak remote-list --user | awk '{print $1}' | grep -qx 'vkintox-local'; then
    run_progress "adding local remote" flatpak remote-add --user --if-not-exists vkintox-local "$BUILD_ROOT/repo" --no-gpg-verify
fi
run_progress "updating local remote" flatpak remote-modify --user --url="file://$BUILD_ROOT/repo" --no-gpg-verify vkintox-local
# 25.08 and 26.08 can both be installed; a branch-less ref is ambiguous, so
# remove every installed branch explicitly before installing the new one.
while read -r ref; do
    [ -n "$ref" ] || continue
    run_progress "removing previous layer" flatpak uninstall --user --noninteractive -y "$ref"
done < <(flatpak list --user --runtime --columns=application,branch 2>/dev/null | awk -v id="$LAYER_ID" '$1==id{print id "//" $2}')
run_progress "installing layer" flatpak install --user --noninteractive -y vkintox-local \
    "runtime/$LAYER_ID/x86_64/26.08"
ok "layer installed"

section "config dirs"
APP_CONFIG="$HOME/.var/app/$APP_ID/config/VKIntox"
RESHADE_DIR="$APP_CONFIG/reshade"
SHADERS_DIR="$RESHADE_DIR/Shaders"
TEXTURES_DIR="$RESHADE_DIR/Textures"
mkdir -p "$SHADERS_DIR" "$TEXTURES_DIR" "$APP_CONFIG/font"
curl -fsSL "https://raw.githubusercontent.com/$REPO/main/VERSION" -o "$APP_CONFIG/version"
# fonts aren't on raw.githubusercontent until pushed to the font ref, so a local
# flatpak build would silently seed nothing. prefer the checkout, else download.
# BASH_SOURCE is unset when the script is piped to bash (curl | bash) or run via
# bash -c, which is how fish users invoke it; guard so set -u doesn't trip.
SCRIPT_DIR=""
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
FONT_SRC=""
if [[ -f "$SCRIPT_DIR/../assets/font/MaterialSymbolsRounded.ttf" ]]; then
    FONT_SRC="$SCRIPT_DIR/../assets/font"
fi

seed_font() {
    local font="$1"
    local dest="${2:-$font}"
    if [[ -n "$FONT_SRC" && -f "$FONT_SRC/$font" ]]; then
        cp "$FONT_SRC/$font" "$APP_CONFIG/font/$dest"
    else
        curl -fsSL "https://raw.githubusercontent.com/$REPO/$ASSET_REF/assets/font/$font" -o "$APP_CONFIG/font/$dest" ||
            die "couldn't fetch $font; re-run this script from inside a VKIntox checkout"
    fi
}

# 0.2.0 introduced the Google Sans + Material Symbols set. older libraries only
# know the single font.ttf, so seed just that and its licence for them.
SELECTED_VERSION="$(basename "$ASSET_URL" | sed -E 's/^libvkintox_flatpak_//; s/_[0-9]{8}\.so$//')"
SELECTED_NUMERIC="${SELECTED_VERSION#v}"; SELECTED_NUMERIC="${SELECTED_NUMERIC%%-*}"; SELECTED_NUMERIC="${SELECTED_NUMERIC%%+*}"
version_ge() {
    if [[ "$1" == "$2" ]]; then
        return 0
    fi
    [[ "$(printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort -V | tail -n1)" == "$1" ]]
}
if version_ge "$SELECTED_NUMERIC" "0.2.0"; then
    for font in GoogleSans-Regular.ttf GoogleSans-Medium.ttf GoogleSans-Bold.ttf GoogleSans-ExtraBold.ttf MaterialSymbolsRounded.ttf LICENSE LICENSE-SIL-OFL-1.1.txt LICENSE-Apache-2.0.txt; do
        seed_font "$font"
    done
    # Keep the historical filename as a regular-weight compatibility fallback.
    cp "$APP_CONFIG/font/GoogleSans-Regular.ttf" "$APP_CONFIG/font/font.ttf"
else
    # the single-font overlay reads bolder on the medium weight than regular.
    seed_font GoogleSans-Medium.ttf font.ttf
    seed_font LICENSE
    seed_font LICENSE-SIL-OFL-1.1.txt
    seed_font LICENSE-Apache-2.0.txt
fi
curl -fsSL "$EFFECT_PACKAGES_URL" -o "$TMP_DIR/EffectPackages.ini"

EFFECTS_HASH=$(sha256sum "$TMP_DIR/EffectPackages.ini" | cut -d' ' -f1)
EFFECTS_MARKER="$RESHADE_DIR/.vkintox_effects_hash"
if [[ ! -f "$EFFECTS_MARKER" || "$(cat "$EFFECTS_MARKER")" != "$EFFECTS_HASH" ]]; then
    say "downloading + extracting packages"
    rm -rf "$SHADERS_DIR" "$TEXTURES_DIR"
    mkdir -p "$SHADERS_DIR" "$TEXTURES_DIR"
    # the old layout nested these under reshade/packages; drop it so shader
    # discovery cannot see the same files in two places
    rm -rf "$RESHADE_DIR/packages"
    python3 - "$TMP_DIR" "$SHADERS_DIR" "$TEXTURES_DIR" "$TMP_DIR/EffectPackages.ini" <<'PYEOF'
import configparser, os, sys, shutil, urllib.request, zipfile

work_dir, shaders_dir, textures_dir, ini_file = sys.argv[1:5]
with open(ini_file, "r", encoding="utf-8-sig") as f:
    cfg = configparser.ConfigParser(strict=False)
    cfg.read_string(f.read())

failed = []
ok = 0
for section in cfg.sections():
    pkg = cfg[section]
    name = pkg.get("PackageName", section)
    url = pkg.get("DownloadUrl")
    if not url:
        continue
    # every package installs into its own directory under Shaders/ and Textures/,
    # named after its InstallPath subdir or, when it targets the shared root, the
    # first word of its PackageName
    def package_dir(configured, root, fallback):
        path = (configured or "").replace("\\", "/")
        marker = "reshade-shaders/" + root
        sub = path.split(marker, 1)[1].strip("/") if marker in path else ""
        sub = sub or fallback
        sub = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in sub).strip("._")
        return sub or "package"

    fallback_dir = (pkg.get("PackageName", section).split() or [section])[0]
    sub_shader = package_dir(pkg.get("InstallPath"), "Shaders", fallback_dir)
    sub_tex = package_dir(pkg.get("TextureInstallPath"), "Textures", sub_shader)

    tgt_shaders = os.path.join(shaders_dir, sub_shader)
    tgt_textures = os.path.join(textures_dir, sub_tex)
    os.makedirs(tgt_shaders, exist_ok=True)
    os.makedirs(tgt_textures, exist_ok=True)
    effect_files = {f.strip() for f in pkg.get("EffectFiles", "").split(",") if f.strip()}
    deny_files = {f.strip() for f in pkg.get("DenyEffectFiles", "").split(",") if f.strip()}
    zip_path = os.path.join(work_dir, f"{section}.zip")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "VKIntox-setup"})
        with urllib.request.urlopen(req) as response, open(zip_path, "wb") as out:
            shutil.copyfileobj(response, out)
        extract_dir = os.path.join(work_dir, section)
        with zipfile.ZipFile(zip_path) as archive:
            archive.extractall(extract_dir)
    except Exception as exc:
        failed.append(f"{name} ({exc})")
        continue
    shader_count = texture_count = 0
    for root, _, files in os.walk(extract_dir):
        for filename in files:
            if filename in deny_files:
                continue
            source = os.path.join(root, filename)
            if filename.endswith((".fx", ".fxh")):
                if filename.endswith(".fx") and effect_files and filename not in effect_files:
                    continue
                shutil.copy2(source, tgt_shaders)
                shader_count += 1
            elif filename.lower().endswith((".png", ".jpg", ".jpeg", ".dds", ".tga", ".bmp")):
                shutil.copy2(source, tgt_textures)
                texture_count += 1
    if shader_count + texture_count == 0:
        failed.append(f"{name} (no matching files)")
    else:
        ok += 1
        print(f"  ✓ {name}: {shader_count} shader(s), {texture_count} texture(s)")

print(f"\n  {ok} package(s) installed")
if failed:
    print("  Packages with problems:")
    for problem in failed:
        print(f"    - {problem}")
    raise SystemExit(1)
PYEOF
    printf '%s\n' "$EFFECTS_HASH" > "$EFFECTS_MARKER"
else
    ok "effects up to date"
fi

# shaders that ship with VKIntox itself, in their own VKIntox package dir beside
# the downloaded packages; refreshed every run so a shader fix lands without a
# package hash change
mkdir -p "$SHADERS_DIR/VKIntox"
for shader in CAS.fx MSAA.fx; do
    curl -fsSL "https://raw.githubusercontent.com/$REPO/$ASSET_REF/assets/builtInShaders/$shader" \
        -o "$SHADERS_DIR/VKIntox/$shader" ||
        warn "couldn't fetch builtInShaders/$shader"
done

section "enable layer"
if ! flatpak override --user "$APP_ID" --env=ENABLE_VKINTOX=1 2>/dev/null; then
    warn "couldn't set ENABLE_VKINTOX; if the app is not installed yet, run:"
    printf '    flatpak override --user %s --env=ENABLE_VKINTOX=1\n' "$APP_ID"
fi
ok "setup finished for $APP_ID"
